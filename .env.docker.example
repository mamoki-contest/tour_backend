# .env.docker 로 복사해 채웁니다. 로컬 개발용 .env 와는 별개 파일입니다.
# .gitignore 의 `.env.*` 규칙으로 커밋되지 않습니다.
#
#   cp .env.docker.example .env.docker
#
# compose 명령마다 --env-file .env.docker 를 붙입니다.

# --- Docker Hub ---
# 이미지 이름이 <사용자명>/tour-backend:<태그> 가 됩니다.
DOCKERHUB_USERNAME=
TAG=latest

# --- DB ---
# DB_HOST 는 반드시 compose 서비스 이름인 db 입니다. localhost 로 두면 앱이 자기 자신에게 붙습니다.
DB_HOST=db
DB_PORT=3306
DB_NAME=tour
DB_USERNAME=tour
DB_PASSWORD=

# 컨테이너의 MySQL root 비밀번호. 위 DB_PASSWORD 와 다른 값으로 둡니다.
MYSQL_ROOT_PASSWORD=

# 비밀번호에 백슬래시(\)를 쓰지 마세요. 이 파일은 properties 로 읽혀 이스케이프 문자로 해석됩니다.
# 영문·숫자·- _ @ 정도로 조합합니다.

# --- 공공데이터포털 (Encoding 키 하나를 5개 서비스가 공유) ---
KOR_SERVICE_KEY=

# --- CORS ---
# 프론트 배포 주소. 여러 개면 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 네이버 검색 API (NAVER API HUB) ---
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=

# --- 카카오 Local REST API ---
KAKAO_REST_API_KEY=

# --- 국가교통정보센터(ITS) ---
ITS_API_KEY=

# --- 적재·수집 스케줄 (기본 전부 꺼짐) ---
# 온라인 언급량 월간 수집을 서버에서 자동으로 돌리려면 true 로 둡니다.
# 켜기 전에 --job=catalog 와 --job=mention 을 손으로 한 번씩 돌려 소요 시간과 호출량을 확인하세요.
BATCH_SCHEDULE_MENTION_ENABLED=false
# 비우면 매월 1일 03:00 (Asia/Seoul).
BATCH_SCHEDULE_MENTION_CRON=

# 카탈로그 재적재. 실패하면 사람이 봐야 하는 작업이라 켜지 않는 쪽을 권합니다.
BATCH_SCHEDULE_CATALOG_ENABLED=false
BATCH_SCHEDULE_CATALOG_CRON=

# cron 을 해석할 시간대. 비우면 Asia/Seoul.
BATCH_SCHEDULE_ZONE=

# 나머지 설정(각 공급자 base-url, 페이지 수, DATA_LAB_LAG_DAYS 등)은
# application.yaml 에 기본값이 있어 비워두면 됩니다. 바꿔야 할 때만 추가하세요.
# 이 파일은 compose 가 컨테이너 환경변수로 넘기지만, 값이 빈 줄은 앱에서
# "지정하지 않은 것"으로 취급되므로 .env 와 똑같이 기본값이 적용됩니다.
# TEST_DB_NAME 은 테스트 프로파일 전용이라 운영에는 필요 없습니다.
