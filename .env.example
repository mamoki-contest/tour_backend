# .env 로 복사한 뒤 각자 환경에 맞게 채웁니다.
# README 1번의 스키마·계정을 만들었다면 그대로 복사해도 앱은 뜹니다.
#
# 값이 비어 있는 줄은 "지정하지 않은 것"으로 취급되어 기본값이 적용됩니다.
# 그래서 기본값을 쓰고 싶은 항목은 아래처럼 아예 주석으로 둡니다. 채울 때 # 을 떼세요.
# 같은 규칙이 .env 파일과 운영체제 환경변수 양쪽에 똑같이 적용됩니다.

# --- 데이터베이스 (반드시 채웁니다) ---
# 여기만은 비워 두면 안 됩니다. 빈 줄은 "지정하지 않은 것" 인데 DB 접속 정보에는
# 기본값이 없어서(계정 이름이나 호스트는 비어 있으면 뜻이 없습니다) 기동이 멈춥니다.
# 비운 채 띄우면 어느 변수가 비었는지 이름으로 알려주고 멈춥니다.
#
# 계정 기본값은 docker-compose.yml 이 만드는 계정과 같은 tour 입니다.
# 직접 띄운 MySQL 을 쓴다면 README 1번의 CREATE USER 를 먼저 실행하세요.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tour
DB_USERNAME=tour
# 비밀번호 없는 계정이면 비워 둡니다.
DB_PASSWORD=tour

# 테스트 전용 스키마. tour_test 이거나 tour_test_ 로 시작하는 이름이어야 테스트가 실행됩니다.
# 여러 갈래를 동시에 돌리면 tour_test_42 처럼 접미어를 붙여 나눕니다.
TEST_DB_NAME=tour_test

# --- 적재·수집 스케줄 (기본 전부 꺼짐) ---
# 켜면 사람이 명령을 치지 않아도 외부 API 호출이 나갑니다. 로컬에서는 보통 켜지 않습니다.
# --job=... 으로 띄운 배치 프로세스에서는 켜져 있어도 스케줄러가 뜨지 않습니다.
#
# 온라인 언급량 월간 수집. 비우면 false.
BATCH_SCHEDULE_MENTION_ENABLED=false
# Spring cron 6자리. 비우면 매월 1일 03:00 (0 0 3 1 * *).
BATCH_SCHEDULE_MENTION_CRON=

# 관광지 카탈로그 재적재. 비우면 false.
# 실패하면 사람이 봐야 하는 작업이라 운영에서도 켜지 않는 쪽을 권합니다.
BATCH_SCHEDULE_CATALOG_ENABLED=false
# 비우면 매월 1일 02:00 (0 0 2 1 * *). 언급량 수집보다 먼저 끝나야 합니다.
BATCH_SCHEDULE_CATALOG_CRON=

# cron 을 해석할 시간대. 비우면 Asia/Seoul.
BATCH_SCHEDULE_ZONE=

# 공공데이터포털 인증키 (Encoding 키).
# KorService2, TatsCnctrRate, LocgoHubTar, TarRlteTar, DataLab 모두 이 키 하나를 사용합니다.
KOR_SERVICE_KEY=

# CORS 허용 출처 (쉼표 구분). 비우면 http://localhost:5173 을 사용합니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 공공데이터포털 주소 재지정 (HTTPS 접속이 막힌 환경에서만) ---
# 기본값은 모두 https 주소라 평소에는 건드리지 않습니다.
# KOR_SERVICE_BASE_URL=
# LOCGO_HUB_BASE_URL=
# TATS_CNCTR_RATE_BASE_URL=
# TAR_RLTE_TAR_BASE_URL=
# DATA_LAB_BASE_URL=

# 공급자 공개 지연 일수. 기본 30 일입니다.
# 이 값이 실제 지연보다 짧으면 빈 응답이 와서 방문 규모가 정보 없음으로 표시됩니다.
# DATA_LAB_LAG_DAYS=

# --- 네이버 검색 API (NAVER API HUB) ---
# NAVER API HUB 에서 발급합니다. 개발자센터 신규 신청은 2026-07-31 종료.
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=

# 기본 주소는 https://naverapihub.apigw.ntruss.com 입니다.
# NAVER_API_HUB_BASE_URL=

# 검색어 뒤에 붙일 말. 기본은 붙이지 않습니다.
# '여행' 을 붙이면 그 말과 함께 쓰이지 않은 글이 빠져 장소 성격에 따라 값이 크게 왜곡됩니다.
# NAVER_QUERY_SUFFIX=

# 이름이 변별력을 잃었다고 볼 기준. 기본 0.10(10%) 입니다.
# 이름+시·군 검색 결과가 시·군 단독 검색의 이 비율을 넘으면 정렬에서 뺍니다.
# NAVER_AMBIGUOUS_RATIO=

# --- 카카오 Local REST API (관광지명 자동 매핑) ---
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
# JavaScript 키가 아니라 REST API 키입니다. 서버 전용이라 프론트에 넘기지 않습니다.
KAKAO_REST_API_KEY=

# --- 국가교통정보센터(ITS) 교통소통정보 ---
# https://openapi.its.go.kr 에서 별도 회원가입 후 발급합니다.
# 공공데이터포털 인증키(KOR_SERVICE_KEY)와 무관한 다른 포털의 키입니다.
ITS_API_KEY=

# 기본 주소는 https://openapi.its.go.kr:9443 입니다.
# ITS_BASE_URL=

# 관광지 좌표에서 사방으로 볼 범위(도). 기본 0.005(약 555m) 입니다.
# ITS_HALF_SPAN=

# --- 강릉시 교통정보 조회서비스 (실시간 주차) ---
# data.go.kr 15140011. 자동승인이라 활용신청 즉시 열립니다.
# 인증키는 위의 KOR_SERVICE_KEY 를 그대로 씁니다(계정당 키 하나).
# 다만 기관코드가 KorService2(B551011) 와 달라 base-url 은 따로 둡니다.
# HTTPS 접속이 되지 않는 환경에서만 http 로 지정합니다. 비우면 기본값을 사용합니다.
# GN_ITS_BASE_URL=

# 한 번에 받을 행 수. 기본 100 입니다.
# 주차장이 13곳뿐이라 1회 호출로 끝납니다. pageNo 가 범위를 넘으면 빈 목록이 아니라
# 전체를 다시 돌려주므로 페이지를 도는 순간 무한루프가 됩니다.
# GN_ITS_ROWS=

# 짧은 간격 연속 호출 시 HTTP 200 에 본문이 {} 만 오는 조용한 스로틀이 있습니다.
# 그때 다시 물어볼 횟수와 기다릴 시간. 기본 2회 / 800ms 입니다.
# GN_ITS_THROTTLE_RETRIES=
# GN_ITS_THROTTLE_BACKOFF=
