# .env 로 복사한 뒤 각자 환경에 맞게 채웁니다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tour
DB_USERNAME=
DB_PASSWORD=

TEST_DB_NAME=tour_test

# --- 적재·수집 스케줄 (기본 전부 꺼짐) ---
# 켜면 사람이 명령을 치지 않아도 외부 API 호출이 나갑니다. 로컬에서는 보통 켜지 않습니다.
# --job=... 으로 띄운 배치 프로세스에서는 켜져 있어도 스케줄러가 뜨지 않습니다.
#
# 온라인 언급량 월간 수집. 비우면 false.
BATCH_SCHEDULE_MENTION_ENABLED=false
# Spring cron 6자리. 비우면 매월 1일 03:00 (0 0 3 1 * *).
BATCH_SCHEDULE_MENTION_CRON=

# 관광지 카탈로그 재적재. 비우면 false.
# 실패하면 사람이 봐야 하는 작업이라 운영에서도 켜지 않는 쪽을 권합니다.
BATCH_SCHEDULE_CATALOG_ENABLED=false
# 비우면 매월 1일 02:00 (0 0 2 1 * *). 언급량 수집보다 먼저 끝나야 합니다.
BATCH_SCHEDULE_CATALOG_CRON=

# cron 을 해석할 시간대. 비우면 Asia/Seoul.
BATCH_SCHEDULE_ZONE=

# 공공데이터포털 인증키 (Encoding 키).
# KorService2, TatsCnctrRate, LocgoHubTar, TarRlteTar, DataLab 모두 이 키 하나를 사용합니다.
KOR_SERVICE_KEY=

# HTTPS 접속이 되지 않는 환경에서만 http 로 덮어씁니다. 비워두면 https 를 사용합니다.
KOR_SERVICE_BASE_URL=

# CORS 허용 출처 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LocgoHubTarService1 (HTTPS 가 되지 않는 환경에서만 http 로 지정)
LOCGO_HUB_BASE_URL=

# TatsCnctrRateService (HTTPS 가 되지 않는 환경에서만 http 로 지정)
TATS_CNCTR_RATE_BASE_URL=

# TarRlteTarService1 (HTTPS 가 되지 않는 환경에서만 http 로 지정)
TAR_RLTE_TAR_BASE_URL=

# DataLabService 지역별 방문자수 (HTTPS 가 되지 않는 환경에서만 http 로 지정)
DATA_LAB_BASE_URL=

# 공급자 공개 지연 일수. 비우면 30 일을 사용합니다.
# 이 값이 실제 지연보다 짧으면 빈 응답이 와서 방문 규모가 정보 없음으로 표시됩니다.
DATA_LAB_LAG_DAYS=

# --- 네이버 검색 API (NAVER API HUB) ---
# NAVER API HUB 에서 발급합니다. 개발자센터 신규 신청은 2026-07-31 종료.
NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=

# 검색어 뒤에 붙일 말. 비우면 붙이지 않습니다(기본).
# '여행' 을 붙이면 그 말과 함께 쓰이지 않은 글이 빠져 장소 성격에 따라 값이 크게 왜곡됩니다.
NAVER_QUERY_SUFFIX=

# 이름이 변별력을 잃었다고 볼 기준. 비우면 0.10(10%)을 사용합니다.
# 이름+시·군 검색 결과가 시·군 단독 검색의 이 비율을 넘으면 정렬에서 뺍니다.
NAVER_AMBIGUOUS_RATIO=

# --- 카카오 Local REST API (관광지명 자동 매핑) ---
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
# JavaScript 키가 아니라 REST API 키입니다. 서버 전용이라 프론트에 넘기지 않습니다.
KAKAO_REST_API_KEY=

# --- 국가교통정보센터(ITS) 교통소통정보 ---
# https://openapi.its.go.kr 에서 별도 회원가입 후 발급합니다.
# 공공데이터포털 인증키(KOR_SERVICE_KEY)와 무관한 다른 포털의 키입니다.
ITS_API_KEY=

# HTTPS 접속이 되지 않는 환경에서만 지정합니다. 비우면 기본값을 사용합니다.
ITS_BASE_URL=

# 관광지 좌표에서 사방으로 볼 범위(도). 비우면 0.005(약 555m)를 사용합니다.
ITS_HALF_SPAN=
